# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in the values. `.env*` is gitignored.
#
# The marketing site runs with NONE of these set. They are only needed for the
# contact form (Supabase + SMTP) and the private /admin inbox.
# ---------------------------------------------------------------------------

# --- Supabase -------------------------------------------------------------
# Project settings -> API. The service-role key bypasses RLS: server-side only,
# never prefix it with NEXT_PUBLIC_ and never send it to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- /admin login ---------------------------------------------------------
# One credential pair, held here. There is no accounts table to seed.
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=use-something-long-and-unique

# Signs the admin session cookie. Minimum 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=

# --- Contact-form email ---------------------------------------------------
# Any SMTP provider. Port 465 = implicit TLS, 587 = STARTTLS.
# For Gmail, use an App Password, not your account password.
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USER=you@example.com
SMTP_PASS=your-smtp-password

# Where enquiries are delivered. Optional — falls back to a hardcoded address
# in app/api/contact/route.ts.
CONTACT_RECIPIENT_EMAIL=you@example.com
