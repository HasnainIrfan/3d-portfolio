# ---------------------------------------------------------------------------
# Copy this file to `.env`. `.env*` is gitignored.
#
# All four are OPTIONAL. With an empty .env the site builds, deploys and runs.
# You just get a "not connected" panel at /admin and the contact form asks
# visitors to email you directly.
#
# There are no server-only secrets in this project. No service-role key, no
# admin password, no session signing key, no SMTP credentials. Admin access is
# Supabase Auth plus a row in public.admin_users; email is sent by a Supabase
# Edge Function using secrets held in Supabase. See docs/admin.md.
# ---------------------------------------------------------------------------

# Your live domain, no trailing slash. Drives the sitemap, robots.txt, canonical
# URL and every Open Graph image URL. Leave it unset locally.
NEXT_PUBLIC_SITE_URL=https://yourdomain.com

# Supabase → Project Settings → API.
# The anon key is a public identifier, not a secret. Row-level security is what
# decides who can read what. It is safe in a browser bundle, which is why it
# carries the NEXT_PUBLIC_ prefix.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional. Google Search Console verification token, the `content` value of the
# google-site-verification meta tag. Leave it unset and the tag is not rendered.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
